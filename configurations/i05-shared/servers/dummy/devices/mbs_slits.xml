<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="mbs_slits" class="org.opengda.detector.electronanalyser.entrance.slit.AnalyserEntranceSlit" destroy-method="dispose">
		<property name="slitScannable" ref="analyser_slit"/>
		<property name="defaultSlitString" value="Straight, S0.1, A1.0"/>
		<property name="splitSeparator" value=", "/>
		<property name="slitShapePosition" value="0"/>
		<property name="slitSizePosition" value="1"/>
	</bean>

	<bean id="analyser_slit" class="gda.device.enumpositioner.DummyEnumPositioner">
		<property name="positions">
			<list>
				<value>Straight, S0.05, A0.5</value>
				<value>Straight, S0.1, A1.0</value>
				<value>Straight, S0.1, A1.3</value>
				<value>Straight, S0.1, A1.9</value>
				<value>Straight, S0.2, A1.0</value>
				<value>Straight, S0.2, A1.9</value>
				<value>Straight, S0.4, A1.9</value>
				<value>Straight, S3.2, A5.4</value>
				<value>Curved, S0.2, A1.0</value>
			</list>
		</property>
		<property name="posChangeEventFlag" value="true"/>
	</bean>

</beans>
