<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd">


	<!-- NX detector to hold ROIStats pairs and make them available in jython -->
	<!-- Names of holder bean conforms to "#{detector_name}_roistats_holder" -->
	<!-- This NX detector should NOT be used in measurements -->
	<bean id="pil3_roistats_holder" class="gda.device.detector.NXDetector">
		<property name="name" value="pil3_roistats_holder" />
		<property name="collectionStrategy" ref="pilatus3_nxcollectionstrategy_for_scans_and_snaps" />
		<property name="additionalPluginList">
			<list>
				<ref bean="pil3_roistats_holder_stats_1"/>
				<ref bean="pil3_roistats_holder_stats_2"/>
				<ref bean="pil3_roistats_holder_stats_3"/>
				<ref bean="pil3_roistats_holder_stats_4"/>
				<ref bean="pil3_roistats_holder_stats_5"/>
				<ref bean="pil3_roistats_holder_stats_6"/>
				<ref bean="pil3_roistats_holder_roi_1"/>
				<ref bean="pil3_roistats_holder_roi_2"/>
				<ref bean="pil3_roistats_holder_roi_3"/>
				<ref bean="pil3_roistats_holder_roi_4"/>
				<ref bean="pil3_roistats_holder_roi_5"/>
				<ref bean="pil3_roistats_holder_roi_6"/>
			</list>
		</property>
	</bean>

	<!-- BASIC STATS PLUGINS -->
	<!-- Names of stat beans conform to "pil3_roistats_holder_stats_N" -->
	<bean id="pil3_roistats_holder_stats_1" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_1"/>
		<constructor-arg ref="pil_stats_1"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_1" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT1:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT1:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi1" />
			</bean>
		</property>
	</bean>

	<bean id="pil3_roistats_holder_stats_2" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_2"/>
		<constructor-arg ref="pil_stats_2"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_2" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT2:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT2:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi2" />
			</bean>
		</property>
	</bean>

	<bean id="pil3_roistats_holder_stats_3" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_3"/>
		<constructor-arg ref="pil_stats_3"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_3" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT3:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT3:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi3" />
			</bean>
		</property>
	</bean>

	<bean id="pil3_roistats_holder_stats_4" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_4"/>
		<constructor-arg ref="pil_stats_4"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_4" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT4:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT4:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi4" />
			</bean>
		</property>
	</bean>

	<bean id="pil3_roistats_holder_stats_5" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_5"/>
		<constructor-arg ref="pil_stats_5"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_5" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT5:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT5:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi5" />
			</bean>
		</property>
	</bean>

	<bean id="pil3_roistats_holder_stats_6" class="gda.device.detector.nxdetector.plugin.areadetector.ADBasicStats">
		<property name="name" value="pil3_roistats_holder_stats_6"/>
		<constructor-arg ref="pil_stats_6"/>
		<property name="computeStats" value="true"/>
	</bean>
	<bean id="pil_stats_6" class="gda.device.detector.areadetector.v17.impl.NDStatsImpl">
		<property name="basePVName" value="BL16I-EA-PILAT-03:STAT6:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL16I-EA-PILAT-03:STAT6:" />
				<property name="initialArrayPort" value="PILATUS3.rois.roi6" />
			</bean>
		</property>
	</bean>

	<!-- AD_ROIS PLUGINS -->
	<!-- Names of roi beans conform to "pil3_roistats_holder_roi_N" -->
	<bean id="pil3_roistats_holder_roi_1" class="gda.device.detector.nxdetector.plugin.areadetector.ADRectangularROIPlugin" factory-method="createFromBasePVName">
		<constructor-arg value="pil3_roistats_holder_roi_1"/>
		<constructor-arg value="BL16I-EA-PILAT-03:ROI1:"/>
		<constructor-arg ref="pilatus_roi_provider_1"/>
		<property name="inputNDArrayPort" value="PILATUS3.cam"/>
	</bean>
	<bean id="pilatus_roi_provider_1" class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="500" />
		<property name="ysize" value="500" />
	</bean>

	<bean id="pil3_roistats_holder_roi_2" class="gda.device.detector.nxdetector.plugin.areadetector.ADRectangularROIPlugin" factory-method="createFromBasePVName">
		<constructor-arg value="pil3_roistats_holder_roi_2"/>
		<constructor-arg value="BL16I-EA-PILAT-03:ROI2:"/>
		<constructor-arg ref="pilatus_roi_provider_2"/>
		<property name="inputNDArrayPort" value="PILATUS3.cam"/>
	</bean>
	<bean id="pilatus_roi_provider_2" class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="500" />
		<property name="ysize" value="500" />
	</bean>

