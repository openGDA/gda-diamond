	</bean>
	<bean id="pilatus_roi_provider_3" class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="500" />
		<property name="ysize" value="500" />
	</bean>

	<bean id="pil3_roistats_holder_roi_4" class="gda.device.detector.nxdetector.plugin.areadetector.ADRectangularROIPlugin" factory-method="createFromBasePVName">
		<constructor-arg value="pil3_roistats_holder_roi_4"/>
		<constructor-arg value="BL16I-EA-PILAT-03:ROI4:"/>
		<constructor-arg ref="pilatus_roi_provider_4"/>
		<property name="inputNDArrayPort" value="PILATUS3.cam"/>
	</bean>
	<bean id="pilatus_roi_provider_4" class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="500" />
		<property name="ysize" value="500" />
	</bean>

	<bean id="pil3_roistats_holder_roi_5" class="gda.device.detector.nxdetector.plugin.areadetector.ADRectangularROIPlugin" factory-method="createFromBasePVName">
		<constructor-arg value="pil3_roistats_holder_roi_5"/>
		<constructor-arg value="BL16I-EA-PILAT-03:ROI5:"/>
		<constructor-arg ref="pilatus_roi_provider_5"/>
		<property name="inputNDArrayPort" value="PILATUS3.cam"/>
	</bean>
	<bean id="pilatus_roi_provider_5" class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="500" />
		<property name="ysize" value="500" />
	</bean>

	<bean id="pil3_roistats_holder_roi_6" class="gda.device.detector.nxdetector.plugin.areadetector.ADRectangularROIPlugin" factory-method="createFromBasePVName">
		<constructor-arg value="pil3_roistats_holder_roi_6"/>
		<constructor-arg value="BL16I-EA-PILAT-03:ROI6:"/>
