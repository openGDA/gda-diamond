<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- NOTE -->
	<!-- We can not configure MovSum plugin in GDA - only in EPICS ! -->
	<!--
	MovSum1 incoming port must be dld.rois.roi1
	MovSum2 incoming port must be dld.rois.roi2
	MovSum3 incoming port must be dld.rois.roi3
	-->

	<!-- Area Detector EPICS Plugins -->
	<bean id="dld_adbase" class="gda.spring.V17ADBaseFactoryBean">
		<property name="prefix" value="BL09K-EA-DET-01:CAM:" />
	</bean>

	<bean id="fixed_roi"
		class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="1212" />
		<property name="ysize" value="1212" />
	</bean>

	<bean id="fixed_roi_python"
		class="gda.device.detector.nxdetector.roi.MutableRectangularIntegerROI">
		<property name="xstart" value="0" />
		<property name="ystart" value="0" />
		<property name="xsize" value="1212" />
		<property name="ysize" value="1212" />
	</bean>

<!-- 	This configuration requires beans from DLD.XML -->
<!-- This proc plugin is used for DATA LIVE VIEWS -->
	<bean id="dld_proc" class="gda.device.detector.areadetector.v17.impl.NDProcessImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PROC:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PROC:"/>
				<property name="initialArrayPort" value="dld.cam"/>
				<!-- initial array address - use 3 for 3D data -->
				<!-- <property name="initialArrayAddress" value="3"/> -->
			</bean>
		</property>
	</bean>

<!-- This proc plugin is used for DATA WRITING -->
	<bean id="dld_proc1" class="gda.device.detector.areadetector.v17.impl.NDProcessImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PROC1:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PROC1:"/>
				<property name="initialArrayPort" value="dld.cam"/>
				<!-- initial array address - use 3 for 3D data -->
				<!-- <property name="initialArrayAddress" value="3"/> -->
			</bean>
		</property>
	</bean>

<!-- These proc plugins are used to correct flat field after moving sum plugins for accumulated live view -->
	<bean id="dld_proc2" class="gda.device.detector.areadetector.v17.impl.NDProcessImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PROC2:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PROC2:"/>
				<property name="initialArrayPort" value="dld.movsum.sum1"/>
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_proc3" class="gda.device.detector.areadetector.v17.impl.NDProcessImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PROC3:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PROC3:"/>
				<property name="initialArrayPort" value="dld.movsum.sum2"/>
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_proc4" class="gda.device.detector.areadetector.v17.impl.NDProcessImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PROC4:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PROC4:"/>
				<property name="initialArrayPort" value="dld.movsum.sum3"/>
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

<!-- Configure ND arrays for GDA client LIVE DATA -->
	<bean id="dld_ndarray_live_XY" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR1:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR1:" />
				<property name="initialArrayPort" value="dld.rois.roi1" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_ndarray_live_XT" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR2:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR2:" />
				<property name="initialArrayPort" value="dld.rois.roi2" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_ndarray_live_YT" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR3:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR3:" />
				<property name="initialArrayPort" value="dld.rois.roi3" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

<!-- Configure ND arrays for GDA client ACCUM DATA -->
	<bean id="dld_ndarray_acc_XY" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR4:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR4:" />
				<property name="initialArrayPort" value="dld.procs.proc2" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_ndarray_acc_XT" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR5:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR5:" />
				<property name="initialArrayPort" value="dld.procs.proc3" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

	<bean id="dld_ndarray_acc_YT" class="gda.device.detector.areadetector.v17.impl.NDArrayImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:ARR6:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:ARR6:" />
				<property name="initialArrayPort" value="dld.procs.proc4" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
	</bean>

<!-- Configure File writing plugins -->
	<bean id="dld_ndfile" class="gda.device.detector.areadetector.v17.impl.NDFileImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:HDF5:" />
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:HDF5:" />
				<property name="initialArrayPort" value="dld.procs.proc1" />
				<property name="initialArrayAddress" value="0"/>
			</bean>
		</property>
		<property name="initialWriteMode" value="0" />
		<property name="initialNumCapture" value="1" />
		<property name="initialFileName" value="dld" />
		<property name="initialFileTemplate" value="%s%s-%d.hdf5" />
	</bean>

	<bean id="dld_hdf5" class="gda.device.detector.areadetector.v17.impl.NDFileHDF5Impl">
		<property name="basePVName" value="BL09K-EA-DET-01:HDF5:" />
		<property name="file" ref="dld_ndfile" />
		<property name="attrByDimPVsAvailable" value="false"/>
		<property name="swmrModePVsAvailable" value="false"/>
	</bean>

	<!-- ROI-STAT pairs -->
	<!-- ROI-STAT pairs configured for correct GDA client stream views -->
	<bean id="dld_RoiStats_XY" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI1:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT1:" />
		<property name="roiInputNdArrayPort" value="dld.proc" />
		<property name="enabledBasicStats" value="Total" />
		<property name="oneTimeSeriesCollectionPerLine" value="false" />
		<property name="legacyTSpvs" value="false"/>
	</bean>

	<bean id="dld_RoiStats_XT" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI2:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT2:" />
		<property name="roiInputNdArrayPort" value="dld.proc" />
		<property name="enabledBasicStats" value="Total" />
		<property name="oneTimeSeriesCollectionPerLine" value="false" />
		<property name="legacyTSpvs" value="false"/>
	</bean>

	<bean id="dld_RoiStats_YT" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI3:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT3:" />
		<property name="roiInputNdArrayPort" value="dld.proc" />
		<property name="enabledBasicStats" value="Total" />
		<property name="oneTimeSeriesCollectionPerLine" value="false" />
		<property name="legacyTSpvs" value="false"/>
	</bean>

	<!-- ROI-STAT pairs for data writing -->
	<bean id="dld_RoiStats" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI4:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT4:" />
		<property name="roiInputNdArrayPort" value="dld.procs.proc1" />
		<property name="enabledBasicStats" value="Total" />
		<property name="oneTimeSeriesCollectionPerLine" value="false" />
		<property name="roiProvider" ref="fixed_roi"/>
		<property name="legacyTSpvs" value="false"/>
	</bean>

	<!-- Python plugin -->
	<bean id="dld_ndPython" class="gda.device.detector.areadetector.v17.impl.NDPythonImpl">
		<property name="basePVName" value="BL09K-EA-DET-01:PY1" />
	<!-- 		these parameters are not set - just to please class afterPropertiesSet() method -->
		<property name="pythonParameters">
			<map>
				<entry key="output" value="Int2_RBV" />
			</map>
		</property>
		<property name="pluginBase">
			<bean class="gda.device.detector.areadetector.v17.impl.NDPluginBaseImpl">
				<property name="basePVName" value="BL09K-EA-DET-01:PY1:" />
				<property name="initialArrayPort" value="dld.procs.proc1" />
			</bean>
		</property>
	</bean>

	<bean id="dld_python" class="gda.device.detector.nxdetector.plugin.areadetector.ADPythonPlugin">
		<property name="ndPython" ref="dld_ndPython" />
		<property name="inputPort" value="dld.procs.proc1"/>
		<property name="enableFileLoad" value="false"/>
		<property name="enableClassLoad" value="false"/>
		<property name="enableParameterValuesLoad" value="false"/>
	</bean>

	<bean id="dld_python_RoiStats" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_python_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI5:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT5:" />
		<property name="roiInputNdArrayPort" value="dld.python.py1" />
		<property name="enabledBasicStats">
			<list>
				<value>Total</value>
				<value>MeanValue</value>
			</list>
		</property>
		<property name="oneTimeSeriesCollectionPerLine" value="false" />
		<property name="roiProvider" ref="fixed_roi_python"/>
		<property name="legacyTSpvs" value="false"/>
	</bean>

	<!-- This ROI is used to monitor acquire procs plugin frames counter in CollectionStrategy -->
	<bean id="dld_procs_monitor_roistats" class="gda.device.detector.nxdetector.plugin.areadetector.ADRoiStatsPairFactory">
		<property name="pluginName" value="dld_python_RoiStats" />
		<property name="baseRoiPVName" value="BL09K-EA-DET-01:ROI:" />
		<property name="baseStatsPVName" value="BL09K-EA-DET-01:STAT:" />
		<property name="roiInputNdArrayPort" value="dld.procs.proc1" />
		<property name="legacyTSpvs" value="false"/>
	</bean>


	<bean id="dldCollectionStrategy" class="gda.device.detector.addetector.collectionstrategy.AutoSummingProcessDecorator">
		<property name="ndProcess" ref="dld_proc1"/>
		<property name="processDataTypeOut" value="10"/>
		<property name="restoreState" value="true"/>
		<property name="applyFlatFieldSettings"	value="false"/>
		<property name="applyProcessDataTypeOutSettings" value="true"/>
		<property name="skipFrame"	value="true"/>
		<property name="decoratee">
			<bean class="gda.device.detector.addetector.collectionstrategy.InternalTriggerModeDecorator">
				<property name="decoratee">
					<bean class="gda.device.detector.addetector.collectionstrategy.ProcStartStop">
						<property name="ndProcess" ref="dld_proc1"/>
						<property name="adBase" ref="dld_adbase" />
						<property name="procMonitorPV" value="BL09K-EA-DET-01:ROI:ArrayCounter_RBV" />
					</bean>
				</property>
			</bean>
		</property>
	</bean>

	<!--  HDF5 plugin configuration -->
	<bean id="dldHdf5Filewriter" class="gda.device.detector.addetector.filewriter.MultipleImagesPerHDF5FileWriter">
		<property name="ndFileHDF5" ref="dld_hdf5"/>
		<property name="fileNameTemplate" value="dld"/>
		<property name="filePathTemplate" value="$datadir$" />
		<property name="fileTemplate" value="%s%s-%d.hdf" />
		<property name="fileNumberAtScanStart" value="0" />
		<property name="setFileNameAndNumber" value="true" />
		<property name="rowChunks" value="0" />
		<property name="colChunks" value="0" />
		<property name="framesChunks" value="1" />
		<property name="framesFlush" value="1" />
		<property name="lazyOpen" value="true" />
		<property name="blocking" value="false" />
		<property name="attrByDimSupported" value="false" />
		<property name="attrByDim" value="false" />
		<property name="pathErrorSuppressed" value="true" />
		<property name="SwmrModeEnabled" value="false"/>
		<property name="ndArrayPortVal" value="dld.procs.proc1"/>
	</bean>

</beans>
