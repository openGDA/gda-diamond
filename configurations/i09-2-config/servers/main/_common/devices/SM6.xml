<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="sm6fpitch" class="gda.device.scannable.ScannableMotor">
		<property name="motor" ref="sm6fpitch_motor" />
	</bean>

	<bean id="sm6_y_wrapper" class="gda.device.scannable.JythonScannableWrapper">
		<property name="scannableName" value="sm6y"/>
		<property name="command" value="sm6y.deleteIObservers()"/>
	</bean>
</beans>
