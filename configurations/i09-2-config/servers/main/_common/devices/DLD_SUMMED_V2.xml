<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- NXDetector -->
	<bean id="dld" class="gda.device.detector.NXDetector">
		<property name="name" value="dld" />
		<property name="collectionStrategy" ref="dldCollectionStrategy" />
		<property name="additionalPluginList">
			<list>
				<ref bean="dld_RoiStats" />
				<ref bean="dldHdf5Filewriter" />
			</list>
		</property>
	</bean>

	<!-- NXDetector -->
	<bean id="dld_py" class="gda.device.detector.NXDetector">
		<property name="name" value="dld_py" />
		<property name="collectionStrategy" ref="dldCollectionStrategy" />
		<property name="additionalPluginList">
			<list>
				<ref bean="dld_RoiStats" />
				<ref bean="dld_python" />
				<ref bean="dld_python_RoiStats" />
				<ref bean="dldHdf5Filewriter" />
			</list>
		</property>
	</bean>

	<!-- NXDetector -->
	<bean id="dld_total" class="gda.device.detector.NXDetector">
		<property name="name" value="dld_total" />
		<property name="collectionStrategy" ref="dldCollectionStrategy" />
		<property name="additionalPluginList">
			<list>
				<ref bean="dld_RoiStats" />
			</list>
		</property>
	</bean>
</beans>