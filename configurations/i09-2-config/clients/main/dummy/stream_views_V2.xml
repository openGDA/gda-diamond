<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<description>
		define all cameras and detectors Live Stream views
	</description>

	<bean id="displayPixelNumberOnAxesXY" class="uk.ac.gda.client.live.stream.calibration.PixelCalibration">
		<property name="xAxisName" value="X"/>
		<property name="yAxisName" value="Y"/>
	</bean>

	<bean id="displayPixelNumberOnAxesXT" class="uk.ac.gda.client.live.stream.calibration.PixelCalibration">
		<property name="xAxisName" value="T"/>
		<property name="yAxisName" value="X"/>
	</bean>

	<bean id="displayPixelNumberOnAxesYT" class="uk.ac.gda.client.live.stream.calibration.PixelCalibration">
		<property name="xAxisName" value="T"/>
		<property name="yAxisName" value="Y"/>
	</bean>


	<bean id="dld_accumimage_xy" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.AccumImageXY"/>
		<property name="displayName" value="DLD Accum Image XY" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesXY"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>


	<bean id="dld_accumimage_xt" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.AccumImageXT"/>
		<property name="displayName" value="DLD Accum Image XT" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesXT"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>


	<bean id="dld_accumimage_yt" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.AccumImageYT"/>
		<property name="displayName" value="DLD Accum Image YT" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesYT"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>



	<bean id="dld_liveimage_xy" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.LiveImageXY"/>
		<property name="displayName" value="DLD Live Image XY" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesXY"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>


	<bean id="dld_liveimage_xt" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.LiveImageXT"/>
		<property name="displayName" value="DLD Live Image XT" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesXT"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>


	<bean id="dld_liveimage_yt" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.LiveImageYT"/>
		<property name="displayName" value="DLD Live Image YT" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesYT"/>
		<property name="bottomUi">
			<bean class="uk.ac.gda.client.live.stream.view.customui.LiveStreamViewLightHistogramControl"/>
		</property>
	</bean>



	<bean id="es32_roi" class="uk.ac.gda.remoting.client.GdaRmiProxyFactoryBean">
		<property name="serviceUrl" value="${gda.rmi.prefix}es32Roi" />
		<property name="serviceInterface" value="gda.device.detector.nxdetector.roi.RemoteRectangularROIsProvider" />
		<property name="refreshStubOnConnectFailure" value="true" />
	</bean>

	<bean id="es32_liveview" class="uk.ac.gda.client.live.stream.view.CameraConfiguration">
		<property name="viewID" value="uk.ac.gda.beamline.i09-2.dld.live.stream.view.ES32AccumImageXY"/>
		<property name="displayName" value="ES32 Accum Image XY" />
		<property name="arrayPv" value="#{ localhostInetAddress.hostName.split('\.')[0] }-AD-SIM-01:ARR" />
		<property name="roiProvider" ref="es32_roi" />
		<property name="calibratedAxesProvider" ref="displayPixelNumberOnAxesXY"/>
	</bean>

</beans>